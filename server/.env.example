# Server environment variables for the Express API
PORT=3001
NODE_ENV=development

# Comma-separated origins allowed to call the API from the browser.
FRONTEND_ORIGIN=http://localhost:8080

# Azure/App Service reverse proxy handling.
TRUST_PROXY=1

# JWT used by the custom OTP flow
JWT_SECRET=replace_with_a_long_random_secret

# Supabase admin access
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMTP transport used for OTP, contact, follow, and report emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="Cyberspace-X <noreply@example.com>"

# Owner mailbox for contact/report notifications
OWNER_EMAIL=owner@example.com
